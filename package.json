{
  "name": "showroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unique stock: one-of-a-kind listings with photos, live status, holds, buying online and questions. A Potomac Solutions platform, built on the kit and Zubra.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node bin/seed.js",
    "demo": "node bin/seed.js --fresh && node server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "@potomac-solutions/kit": "github:Potomac-Solutions/kit#2b0f615563f5ce7bb85cbd9f2c10ac06776c0d90",
    "@zubra/compiler": "5.19.0",
    "@zubra/runtime": "5.19.0",
    "@zubra/server": "5.19.0",
    "@zubra/sync": "5.19.0"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": "26.x"
  }
}
